# Copy to .env (gitignored) and fill in.

# Backend API. Defaults to http://localhost:5299/api when unset.
VITE_API_BASE_URL=http://localhost:5299/api

# Image and file uploads in the editor. Without these, uploads show an error.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 1
              },
              "content": [
                {
                  "type": "text",
                  "text": "Welcome, coders!"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This term we learn how to give a computer instructions. Open Modules to start with Week 1."
                }
              ]
            },
            {
              "type": "callout",
              "attrs": {
                "variant": "success"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Everything here is made for you to try. Mistakes are how programmers learn."
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],

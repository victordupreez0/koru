                {
                  "type": "blockquote",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A computer never guesses what you meant. It only does what you wrote."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "horizontalRule"
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "What code looks like"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Here is a tiny program in a language called Python:"
                    }
                  ]
                },
                {
                  "type": "codeBlock",
                  "attrs": {
                    "language": "python"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "name = \"Grade 5\"\nprint(\"Hello, \" + name)"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "How to fix a bug"
                    }
                  ]
                },
                {
                  "type": "orderedList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Read your code one line at a time"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Find the line that went wrong"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Change it and try again"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Before the next page"
                    }
                  ]
                },
                {
                  "type": "taskList",
                  "content": [
                    {
                      "type": "taskItem",
                      "attrs": {
                        "checked": false
                      },
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "I watched the video"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "taskItem",
                      "attrs": {
                        "checked": false
                      },
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "I can explain what a command is"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "taskItem",
                      "attrs": {
                        "checked": false
                      },
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "I downloaded the cheat sheet"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "fileAttachment",
                  "attrs": {
                    "url": "http://localhost:5299/demo/commands-cheat-sheet.pdf",
                    "name": "commands-cheat-sheet.pdf",
                    "size": 3200
                  }
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Next up: light up a letter"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Then: help the robot reach the flag"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "callout",
                  "attrs": {

  "module": "Week 1: Telling computers what to do",
  "items": [
    {
      "label": "What is coding?",
      "content": {
        "title": "What is coding?",
        "sections": [
          {
            "id": "main",
            "type": "text",
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "callout",
                  "attrs": {
                    "variant": "info"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "By the end of this page you will know what a program is and how to read one."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 1
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Computers follow instructions"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A "
                    },
                    {
                      "type": "text",
                      "text": "program",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " is a list of instructions. The computer does "
                    },
                    {
                      "type": "text",
                      "text": "exactly",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " what the list says, one line at a time. You can learn more at "
                    },
                    {
                      "type": "text",
                      "text": "code.org",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://code.org",
                            "target": "_blank",
                            "rel": "noopener noreferrer",
                            "class": null
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },

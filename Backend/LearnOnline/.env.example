# Copy to .env (gitignored) and fill in. Real environment variables win over this file.

# Your OWN Postgres database. The backend writes to it on every start, and refuses to start against the shared "defaultdb".
ConnectionStrings__LearnOnlineDb=Host=localhost;Port=5433;Database=koru;Username=postgres;Password=koru_local

# AI assistant and "Generate a quiz". Without a key those features fail with a friendly message.
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Only for wiping a populated database back to the seed data. Leave unset.
# ALLOW_DESTRUCTIVE_SEED=true
